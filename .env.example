# Production settings for docker-compose.prod.yml. Copy to .env on the server, fill in,
# then `chmod 600 .env`. Never commit .env.

# So that plain `docker compose ...` on the server always includes the production file.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Your DuckDNS name, without https:// (for the links in alerts).
DOMAIN=yourname.duckdns.org
# Where the host's Caddy reaches the app (127.0.0.1 only). Pick a port no other app uses.
FRONTEND_PORT=8090

# Generate each with: openssl rand -hex 32
# (hex only: the database password goes into a URL, where symbols would break it)
POSTGRES_PASSWORD=
JWT_SECRET=

# Gmail: https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# Alerts are sent from this account; Gmail replaces any other From address with it.
SMTP_USERNAME=you@gmail.com
# The 16-character app password, without spaces.
SMTP_PASSWORD=
MAIL_FROM="Sakshy <you@gmail.com>"
# Defaults: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_TLS=starttls

# Telegram (optional: leave all three empty for none). Your chat gets every check's alerts,
# and a message when someone else signs up, adds a check, or changes who a check emails.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your Sakshy login: your own checks ring, others arrive silently.
TELEGRAM_OWNER_EMAIL=
