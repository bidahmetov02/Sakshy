# Site block for the host's Caddy: add it to /etc/caddy/Caddyfile, set the name and the
# port (FRONTEND_PORT in .env), then `sudo systemctl reload caddy`. Caddy gets the
# certificate; SSE (text/event-stream) passes through unbuffered on its own.
yourname.duckdns.org {
	reverse_proxy 127.0.0.1:8090
}
